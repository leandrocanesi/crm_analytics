# ===== Customer Intelligence Lab — variáveis de ambiente (exemplo) =====
# Copie para .env e ajuste. NUNCA commite o .env real.

# ---- Backend (FastAPI) ----
API_TITLE="Customer Intelligence Lab API"
API_VERSION="0.1.0"
# Origens permitidas para CORS (frontend em dev)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# DIRETÓRIO de snapshots publicados (somente leitura pela API). NÃO é um arquivo
# fixo: o arquivo .duckdb ativo é resolvido em runtime via current.json (troca
# atômica blue-green feita pelo Dagster). Relativo = a partir de backend/.
# Ver docs/snapshots.md §7.
SNAPSHOTS_DIR="../data/snapshots"
# Versão do contrato de snapshot que a API entende (recusa outras).
SCHEMA_VERSION_SUPPORTED="1"
# Data de referência (as-of) FIXA do dataset — NUNCA a data de hoje.
AS_OF_DATE="2018-01-01"
# Moeda dos valores monetários (receita da amostra do painel).
CURRENCY="USD"

# ---- Frontend (Vite) ----
# Base URL da API consumida pelo frontend.
VITE_API_BASE_URL="http://localhost:8000"

# ---- Dagster (Fase 2+) ----
# DAGSTER_HOME="./dagster_home"
