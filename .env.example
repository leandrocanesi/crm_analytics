# ===== Customer Intelligence Lab — variáveis de ambiente (exemplo) =====
# Copie para .env e ajuste. NUNCA commite o .env real.

# ---- Backend (FastAPI) ----
API_TITLE="Customer Intelligence Lab API"
API_VERSION="0.1.0"
# Origens permitidas para CORS (frontend em dev)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# Caminho do snapshot DuckDB publicado (somente leitura pela API).
# Gerado pelo pipeline Dagster (Fase 2+). Pode não existir ainda.
SNAPSHOT_DB_PATH="../data/snapshots/current.duckdb"

# ---- Frontend (Vite) ----
# Base URL da API consumida pelo frontend.
VITE_API_BASE_URL="http://localhost:8000"

# ---- Dagster (Fase 2+) ----
# DAGSTER_HOME="./dagster_home"
