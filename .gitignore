# ===== Customer Intelligence Lab — .gitignore =====

# ---- Segredos / ambiente ----
.env
.env.local
*.local
.env.*.local

# ---- Python / Backend / Pipelines ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dagster/
dagster_home/

# ---- Node / Frontend ----
node_modules/
frontend/dist/
dist/
build/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Dados ----
# Dados brutos da dunnhumby NÃO vão para o git (tamanho + termos de uso).
# Apenas o procedimento de download é versionado (docs/).
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md

# Dados derivados/processados e snapshots são reprodutíveis -> não versionar.
data/processed/*
!data/processed/.gitkeep
data/snapshots/*
!data/snapshots/.gitkeep

# ---- DuckDB / Parquet (artefatos reprodutíveis) ----
*.duckdb
*.duckdb.wal
*.duckdb.tmp/
*.parquet

# ---- SO / Editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---- OneDrive ----
# (pasta sincronizada; itens acima evitam sincronizar artefatos pesados)
