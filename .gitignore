# ===== Customer Intelligence Lab — .gitignore =====

# ---- Segredos / ambiente ----
.env
.env.local
*.local
.env.*.local

# ---- Python / Backend / Pipelines ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dagster/
dagster_home/
.tmp_dagster_home_*/

# ---- Node / Frontend ----
node_modules/
frontend/dist/
dist/
build/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Dados ----
# Dados brutos da dunnhumby NÃO vão para o git (tamanho + termos de uso /
# licença 84.51°). Apenas metadados leves (download, proveniência) são versionados.
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
# Reincluir a pasta do dataset para permitir SOMENTE os metadados de texto;
# os dados brutos (*.rds/*.rda) continuam ignorados pela regra completejourney/* abaixo.
!data/raw/completejourney/
data/raw/completejourney/*
!data/raw/completejourney/.gitkeep
!data/raw/completejourney/README.md
!data/raw/completejourney/PROVENANCE.md
!data/raw/completejourney/SHA256SUMS.txt

# Dados derivados/processados e snapshots são reprodutíveis -> não versionar.
data/processed/*
!data/processed/.gitkeep
data/snapshots/*
!data/snapshots/.gitkeep

# ---- DuckDB / Parquet (artefatos reprodutíveis) ----
*.duckdb
*.duckdb.wal
*.duckdb.tmp/
*.parquet

# ---- Dados brutos R (dunnhumby) — nunca versionar (licença + tamanho) ----
*.rds
*.rda

# ---- SO / Editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---- OneDrive ----
# (pasta sincronizada; itens acima evitam sincronizar artefatos pesados)
